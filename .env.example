NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/tract-app2
JWT_ACCESS_SECRET=<generate_strong_secret_min_32_chars>
# MUST match App 1 JWT_REFRESH_SECRET exactly — shared httpOnly refresh cookie SSO on .tractcorp.com
JWT_REFRESH_SECRET=<generate_strong_secret_min_32_chars>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Comma-separated SPA origins (required). Include both Tract frontends for cross-app cookie SSO.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://seller.tractcorp.com,https://buyer.tractcorp.com
# CORS_ORIGIN=http://localhost:5173,https://tract-app2-frontend.vercel.app
# Local: default broker. Render/Fly/Vercel: set a cloud URL (Upstash, Redis Cloud, etc.) — rediss:// for TLS.
REDIS_URL=redis://localhost:6379
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<your_twilio_auth_token>
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Resend (transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=TRACT <onboarding@resend.dev>
THROTTLE_TTL=60
THROTTLE_LIMIT=100
TEST_BYPASS_OTP=false
TEST_OTP_CODE=123456
TEST_PHONES=
TEST_EMAILS=

# App 1 internal API (service-to-service). Local App1 default port is 3000.
APP1_INTERNAL_URL=http://localhost:3001
# Must match App 1 INTERNAL_SERVICE_KEY exactly (header: X-Internal-Key).
INTERNAL_SERVICE_KEY=bkOpWBztIP27VHrBc8qNDX0I4TZkidml8NSEAmwIW/0=

# SPA origin (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Jumio KYC (same integration shape as tract-app1-backend: OAuth → POST /accounts → sdk.token for Web SDK)
# Leave KYC_REQUIRED unset/false until Jumio is live — identity is auto-approved and not gated.
KYC_REQUIRED=false
KYC_WEBHOOK_SECRET=dev-local-kyc-secret
JUMIO_API_KEY=
JUMIO_API_SECRET=
#
# callbackUrl sent to Jumio — prefer explicit HTTPS URL (ngrok / prod API host).
# tract-app1 uses the deployed API origin only (example: https://tract-app1-backend.onrender.com).
# You may instead point at your webhook route if your Jumio setup expects it, e.g.:
#   https://YOUR-HOST/api/v1/auth/kyc/webhook
#
# Local dev: expose API over HTTPS (ngrok/cloudflared) and set:
# JUMIO_CALLBACK_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
#
API_PUBLIC_URL=http://127.0.0.1:3001
JUMIO_WORKFLOW_KEY=10547

# DocuSeal (shared workspace with App 1 — DOCUSEAL_API_URL and DOCUSEAL_API_KEY must match App 1)
DOCUSEAL_API_URL=https://docu.tractcorp.com
DOCUSEAL_API_KEY=
# Numeric template id, share slug, or full /d/{slug} URL
# End-buyer PSA: https://docu.tractcorp.com/d/rYfZo5ea82js5P
# Prefer numeric id; slug or full /d/{{slug}} URL also supported
DOCUSEAL_CONTRACT_TEMPLATE_ID=2
DOCUSEAL_WEBHOOK_SECRET=

# Cloudinary (draft/signed contract PDFs — same account as App 1)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ATTOM Data API — parcel lookup for Create Listing address prefill
# Use the SAME values as tract-app1-backend (shared account / key).
ATTOM_API_KEY=
# Optional overrides — defaults shown
# ATTOM_API_URL=https://api.gateway.attomdata.com
# ATTOM_PROPERTY_ENDPOINT=/propertyapi/v1.0.0/property/expandedprofile

# Google Places API — address typeahead (same key as App 1)
GOOGLE_PLACES_API_KEY=

# Google OAuth — "Sign in with Google" (separate Cloud project/client from GOOGLE_PLACES_API_KEY)
# Create at https://console.cloud.google.com/apis/credentials — Web application client.
# Authorized redirect URI must exactly match GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# PayPal (platform fee 0.75% × listing purchasePrice after both contract signatures)
# Sandbox: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Optional — webhook URL: https://<api-host>/api/v1/payments/paypal/webhook
PAYPAL_WEBHOOK_ID=
